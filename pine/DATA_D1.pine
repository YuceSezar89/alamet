//@version=6
// DEPV2 GÜNLÜK VERİ 1 — günlük paket (W/M/Y seviyeleri, Devisso) doğrulaması için 20 sembolün günlük OHLC'si.
// BINANCE:BTCUSDT.P, 1 GÜN (1D) grafikte çalıştırılır; 'Export chart data' ile dışa aktarılır. Sembol 1 (BTC) OHLC'si grafiğin kendi sütunlarındadır.
indicator("DEPV2 GÜNLÜK VERİ 1", shorttitle = "DD1", precision = 8)

t2 = input.symbol("BINANCE:ETHUSDT.P", "Symbol 2")
t3 = input.symbol("BINANCE:SOLUSDT.P", "Symbol 3")
t4 = input.symbol("BINANCE:BNBUSDT.P", "Symbol 4")
t5 = input.symbol("BINANCE:XRPUSDT.P", "Symbol 5")
t6 = input.symbol("BINANCE:DOGEUSDT.P", "Symbol 6")
t7 = input.symbol("BINANCE:ADAUSDT.P", "Symbol 7")
t8 = input.symbol("BINANCE:AVAXUSDT.P", "Symbol 8")
t9 = input.symbol("BINANCE:LINKUSDT.P", "Symbol 9")
t10 = input.symbol("BINANCE:TRXUSDT.P", "Symbol 10")
t11 = input.symbol("BINANCE:DOTUSDT.P", "Symbol 11")
t12 = input.symbol("BINANCE:LTCUSDT.P", "Symbol 12")

f_pk() => [open, high, low, close]

[o2, h2, l2, c2] = request.security(t2, timeframe.period, f_pk())
[o3, h3, l3, c3] = request.security(t3, timeframe.period, f_pk())
[o4, h4, l4, c4] = request.security(t4, timeframe.period, f_pk())
[o5, h5, l5, c5] = request.security(t5, timeframe.period, f_pk())
[o6, h6, l6, c6] = request.security(t6, timeframe.period, f_pk())
[o7, h7, l7, c7] = request.security(t7, timeframe.period, f_pk())
[o8, h8, l8, c8] = request.security(t8, timeframe.period, f_pk())
[o9, h9, l9, c9] = request.security(t9, timeframe.period, f_pk())
[o10, h10, l10, c10] = request.security(t10, timeframe.period, f_pk())
[o11, h11, l11, c11] = request.security(t11, timeframe.period, f_pk())
[o12, h12, l12, c12] = request.security(t12, timeframe.period, f_pk())

plot(o2, "O02")
plot(h2, "H02")
plot(l2, "L02")
plot(c2, "C02")
plot(o3, "O03")
plot(h3, "H03")
plot(l3, "L03")
plot(c3, "C03")
