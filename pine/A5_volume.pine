//@version=6
// DEPV2 A5 — ④ HACİM yöntemi (kaynak: Devis'So Otomatik Bot Eğitim PaneliV2, f_sym 546-572. satırlar)
// V dikey = bağıl hacim (hacim / SMA). V yatay = son N barın hacminin şu anki fiyat bölgesinde (±band×ATR) payı.
// Oran = V dikey / V yatay payı. Yön: CLV delta akışı.
indicator("DEPV2 A5 · HACİM", shorttitle = "A5", precision = 8)

atrLen = input.int(10, "ATR Length (atrPeriod)", minval = 1)
hvLen  = input.int(12, "HACİM: akış / bağıl hacim / profil penceresi", minval = 5)
hvBand = input.float(0.5, "HACİM: fiyat bölgesi genişliği (± ATR)", minval = 0.1, step = 0.1)
hvThr  = input.float(2.0, "HACİM: min. katılım oranı (V dikey / V yatay payı)", minval = 0.5, step = 0.1)
hvFlow = input.float(0.1, "HACİM: min. akış oranı (|delta| / toplam hacim)", minval = 0.01, maxval = 1.0, step = 0.01)

atrV = ta.atr(atrLen)
float rgO = high - low

float hvSma = ta.sma(volume, hvLen)
float relV  = hvSma > 0 ? volume / hvSma : 1.0
float dltV  = rgO > 0 ? volume * ((close - low) - (high - close)) / rgO : 0.0
float sumD  = math.sum(dltV, hvLen)
float sumV  = math.sum(volume, hvLen)
float flowV = sumV > 0 ? sumD / sumV : 0.0
float sumIn  = 0.0
float sumAll = 0.0
for i = 0 to hvLen - 1
    float vi = nz(volume[i])
    sumAll += vi
    if math.abs(hlc3[i] - close) <= hvBand * atrV
        sumIn += vi
float hvShare = sumAll > 0 ? sumIn / sumAll : 0.0
float hvRat   = relV / math.max(hvShare, 0.1)
bool hvUp = hvRat >= hvThr and flowV >= hvFlow
bool hvDn = hvRat >= hvThr and flowV <= -hvFlow
var int hvSt = 0
if hvUp
    hvSt := 1
else if hvDn
    hvSt := -1
else if (hvSt == 1 and flowV < 0) or (hvSt == -1 and flowV > 0)
    hvSt := 0
int strHv = hvRat >= hvThr * 1.5 ? 2 : (hvRat >= hvThr * 1.2 ? 1 : 0)

plot(volume,  "VOL")
plot(relV,    "HV_RELV")
plot(flowV,   "HV_FLOW")
plot(hvShare, "HV_SHARE")
plot(hvRat,   "HV_RAT")
plot(hvSt,    "HV_STATE")
plot(strHv,   "HV_STR")
