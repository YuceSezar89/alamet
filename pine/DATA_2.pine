//@version=6
// DEPV2 VERİ 2 — bütün-sistem doğrulaması için 20 sembolün 15 dk OHLCV'sini tek grafiğin zaman eksenine toplar.
// BINANCE:BTCUSDT.P, 15 dk grafikte çalıştırılır; 'Export chart data' ile dışa aktarılır. Sembol 1 (BTC) OHLC'si grafiğin kendi sütunlarındadır.
indicator("DEPV2 VERİ 2", shorttitle = "DV2", precision = 8)

t13 = input.symbol("BINANCE:BCHUSDT.P", "Symbol 13")
t14 = input.symbol("BINANCE:ATOMUSDT.P", "Symbol 14")
t15 = input.symbol("BINANCE:NEARUSDT.P", "Symbol 15")
t16 = input.symbol("BINANCE:APTUSDT.P", "Symbol 16")
t17 = input.symbol("BINANCE:ARBUSDT.P", "Symbol 17")
t18 = input.symbol("BINANCE:OPUSDT.P", "Symbol 18")
t19 = input.symbol("BINANCE:SUIUSDT.P", "Symbol 19")
t20 = input.symbol("BINANCE:INJUSDT.P", "Symbol 20")

f_pk() => [open, high, low, close, volume]

[o13, h13, l13, c13, v13] = request.security(t13, timeframe.period, f_pk())
[o14, h14, l14, c14, v14] = request.security(t14, timeframe.period, f_pk())
[o15, h15, l15, c15, v15] = request.security(t15, timeframe.period, f_pk())
[o16, h16, l16, c16, v16] = request.security(t16, timeframe.period, f_pk())
[o17, h17, l17, c17, v17] = request.security(t17, timeframe.period, f_pk())
[o18, h18, l18, c18, v18] = request.security(t18, timeframe.period, f_pk())
[o19, h19, l19, c19, v19] = request.security(t19, timeframe.period, f_pk())
[o20, h20, l20, c20, v20] = request.security(t20, timeframe.period, f_pk())

plot(o13, "O13")
plot(h13, "H13")
plot(l13, "L13")
plot(c13, "C13")
plot(v13, "V13")
plot(o14, "O14")
plot(h14, "H14")
plot(l14, "L14")
plot(c14, "C14")
plot(v14, "V14")
plot(o15, "O15")
plot(h15, "H15")
plot(l15, "L15")
plot(c15, "C15")
plot(v15, "V15")
plot(o16, "O16")
plot(h16, "H16")
plot(l16, "L16")
plot(c16, "C16")
plot(v16, "V16")
plot(o17, "O17")
plot(h17, "H17")
plot(l17, "L17")
plot(c17, "C17")
plot(v17, "V17")
plot(o18, "O18")
plot(h18, "H18")
plot(l18, "L18")
plot(c18, "C18")
plot(v18, "V18")
plot(o19, "O19")
plot(h19, "H19")
plot(l19, "L19")
plot(c19, "C19")
plot(v19, "V19")
plot(o20, "O20")
plot(h20, "H20")
plot(l20, "L20")
plot(c20, "C20")
plot(v20, "V20")
