//@version=6
// DEPV2 A4 — ③ VOLATİLİTE yöntemi (kaynak: Devis'So Otomatik Bot Eğitim PaneliV2, f_sym 528-544. satırlar)
// Girdi: bar aralığı (TR). TR / önceki yavaş ATR = genişleme oranı. Yön, genişleme barının gövdesidir.
indicator("DEPV2 A4 · VOLATİLİTE", shorttitle = "A4", precision = 8)

vaSlow = input.int(12, "VOLATİLİTE: yavaş ATR periyodu", minval = 5)
vaFast = input.int(5, "VOLATİLİTE: hızlı ATR periyodu (sakinleşme tespiti)", minval = 2)
vaThr  = input.float(1.3, "VOLATİLİTE: min. genişleme oranı (TR / ATR)", minval = 1.0, step = 0.05)
vaCalm = input.float(0.8, "VOLATİLİTE: hızlı ATR / yavaş ATR bunun altına inerse durum sıfırlanır", minval = 0.1, maxval = 1.0, step = 0.05)

float vaTr  = ta.tr(true)
float atrSl = ta.atr(vaSlow)
float atrFs = ta.atr(vaFast)
float vaX   = nz(atrSl[1]) > 0 ? vaTr / atrSl[1] : 1.0
float vaRat = atrSl > 0 ? atrFs / atrSl : 1.0
bool vaUp = vaX >= vaThr and close > open
bool vaDn = vaX >= vaThr and close < open
var int vaSt = 0
if vaUp
    vaSt := 1
else if vaDn
    vaSt := -1
else if vaRat < vaCalm
    vaSt := 0
int strVa = vaX >= vaThr * 1.5 ? 2 : (vaX >= vaThr * 1.2 ? 1 : 0)

plot(vaX,   "VA_X")
plot(vaRat, "VA_RAT")
plot(vaSt,  "VA_STATE")
plot(strVa, "VA_STR")
