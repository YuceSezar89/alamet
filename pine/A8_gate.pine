//@version=6
// DEPV2 A8 — ONAY MAKİNESİ f_gate + 4 yöntemin birleşimi (kaynak: Devis'So Otomatik Bot Eğitim PaneliV2,
// f_gate 411-470 ve f_sym 483-572). A1–A7'nin tamamını içerir; her yöntem için ayrı gate örneği çalışır.
// Çıktı (yöntem başına): yön (son ONAYLI sinyal), başlangıç fiyatı, güç kodu, bekleyen yön, son onay bar_index'i.
// Grafik periyodu sinyal TF'si (15 dk) olmalı.
indicator("DEPV2 A8 · ONAY MAKİNESİ", shorttitle = "A8", precision = 8)

atrPeriod = input.int(10, "ATR Length (atrPeriod)", minval = 1)
tdLen  = input.int(24, "TREND: seviye ortalaması periyodu (HLC3 SMA)", minval = 3)
tdThr  = input.float(0.5, "TREND: min. seviye skoru", minval = 0.05, step = 0.05)
moLen  = input.int(12, "MOMENTUM: ROC periyodu (bar)", minval = 2)
moZLen = input.int(48, "MOMENTUM: σ penceresi", minval = 10)
moThr  = input.float(1.0, "MOMENTUM: min. |z|", minval = 0.1, step = 0.1)
vaSlow = input.int(12, "VOLATİLİTE: yavaş ATR periyodu", minval = 5)
vaFast = input.int(5, "VOLATİLİTE: hızlı ATR periyodu", minval = 2)
vaThr  = input.float(1.3, "VOLATİLİTE: min. genişleme oranı", minval = 1.0, step = 0.05)
vaCalm = input.float(0.8, "VOLATİLİTE: sakinleşme eşiği", minval = 0.1, maxval = 1.0, step = 0.05)
hvLen  = input.int(12, "HACİM: pencere", minval = 5)
hvBand = input.float(0.5, "HACİM: fiyat bölgesi genişliği (± ATR)", minval = 0.1, step = 0.1)
hvThr  = input.float(2.0, "HACİM: min. katılım oranı", minval = 0.5, step = 0.1)
hvFlow = input.float(0.1, "HACİM: min. akış oranı", minval = 0.01, maxval = 1.0, step = 0.01)

ssTf = input.timeframe("15", "Sinyal zaman dilimi (ssTf)")
vpM1 = input.int(2, "MTF 1 çarpanı", minval = 2)
vpM2 = input.int(3, "MTF 2 çarpanı", minval = 2)
vpM3 = input.int(4, "MTF 3 çarpanı", minval = 2)
vpM4 = input.int(6, "MTF 4 çarpanı", minval = 2)
vpCool     = input.int(10, "Sinyal cooldown (sinyal TF barı)", minval = 1, maxval = 100)
vpTfOn     = input.bool(true, "TF onayı sistemini aç")
vpTfNeed   = input.int(3, "Onay için gereken MTF Heikin Ashi sayısı (4 üzerinden)", minval = 1, maxval = 4)
vpConfBars = input.int(1, "Onay için ardışık bar sayısı", minval = 1, maxval = 10)
vpPendMax  = input.int(12, "Onay bekleme süresi (bar)", minval = 1, maxval = 200)

string tfM1 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM1)
string tfM2 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM2)
string tfM3 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM3)
string tfM4 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM4)

f_haScore(string tf) =>
    bool nw = timeframe.change(tf)
    var float cO = na
    var float cH = na
    var float cL = na
    var float pHaO = na
    var float pHaC = na
    if nw or na(cO)
        if not na(cO)
            float lastC = (cO + cH + cL + close[1]) / 4.0
            float lastO = na(pHaO) ? (cO + close[1]) / 2.0 : (pHaO + pHaC) / 2.0
            pHaO := lastO
            pHaC := lastC
        cO := open
        cH := high
        cL := low
    else
        cH := math.max(cH, high)
        cL := math.min(cL, low)
    float haC = (cO + cH + cL + close) / 4.0
    float haO = na(pHaO) ? (cO + close) / 2.0 : (pHaO + pHaC) / 2.0
    float haH = math.max(cH, math.max(haO, haC))
    float haL = math.min(cL, math.min(haO, haC))
    float rg  = haH - haL
    rg != 0 ? (haC - haO) / rg * 100.0 : 0.0

f_gate(bool rawL, bool rawS, bool tfL, bool tfS, int strL, int strS) =>
    var int confDir = 0
    var int lastBar = 0
    var int pendDir = 0
    var int pendBar = 0
    var int pendStr = 0
    var int confCnt = 0
    var float lastSig = -100000.0
    if pendDir == 1 and (not rawL or bar_index - pendBar > vpPendMax)
        pendDir := 0
        confCnt := 0
    if pendDir == -1 and (not rawS or bar_index - pendBar > vpPendMax)
        pendDir := 0
        confCnt := 0
    bool coolOk = (bar_index - lastBar) >= vpCool
    if rawL and confDir != 1 and pendDir != 1 and coolOk
        pendDir := 1
        pendBar := bar_index
        pendStr := strL
        confCnt := 0
        lastBar := bar_index
    if rawS and confDir != -1 and pendDir != -1 and coolOk
        pendDir := -1
        pendBar := bar_index
        pendStr := strS
        confCnt := 0
        lastBar := bar_index
    bool sigL = false
    bool sigS = false
    int  sStr = 0
    if pendDir == 1
        confCnt := tfL ? confCnt + 1 : 0
        if confCnt >= vpConfBars
            sigL := true
            sStr := pendStr + (bar_index > pendBar ? 3 : 0)
            confDir := 1
            pendDir := 0
            confCnt := 0
    else if pendDir == -1
        confCnt := tfS ? confCnt + 1 : 0
        if confCnt >= vpConfBars
            sigS := true
            sStr := pendStr + (bar_index > pendBar ? 3 : 0)
            confDir := -1
            pendDir := 0
            confCnt := 0
    var float lastStart = na
    var float lastType  = 0.0
    var int   lastStr   = 0
    if sigL
        lastStart := low
        lastType  := 1.0
        lastStr   := sStr
        lastSig   := 1.0 * bar_index
    if sigS
        lastStart := high
        lastType  := -1.0
        lastStr   := sStr
        lastSig   := 1.0 * bar_index
    [lastType, lastStart, 1.0 * lastStr, 1.0 * pendDir, lastSig]

// ---- MTF Heikin Ashi gücü + TF onayı (A6 + A7) ----
float hs1 = f_haScore(tfM1)
float hs2 = f_haScore(tfM2)
float hs3 = f_haScore(tfM3)
float hs4 = f_haScore(tfM4)
int nBullTf = (hs1 > 0 ? 1 : 0) + (hs2 > 0 ? 1 : 0) + (hs3 > 0 ? 1 : 0) + (hs4 > 0 ? 1 : 0)
int nBearTf = (hs1 < 0 ? 1 : 0) + (hs2 < 0 ? 1 : 0) + (hs3 < 0 ? 1 : 0) + (hs4 < 0 ? 1 : 0)
bool tfOkL = not vpTfOn or nBullTf >= vpTfNeed
bool tfOkS = not vpTfOn or nBearTf >= vpTfNeed

atrV = ta.atr(atrPeriod)
float rgO = high - low

// ---- ① TREND (A2) ----
float tdMa = ta.sma(hlc3, tdLen)
float tdZ  = atrV > 0 ? (close - tdMa) / atrV : 0.0
var int tdSt = 0
if tdZ >= tdThr
    tdSt := 1
else if tdZ <= -tdThr
    tdSt := -1
else if (tdSt == 1 and tdZ < 0) or (tdSt == -1 and tdZ > 0)
    tdSt := 0
int strTd = math.abs(tdZ) >= tdThr * 3 ? 2 : (math.abs(tdZ) >= tdThr * 2 ? 1 : 0)
[ty0, st0, sg0, pd0, sb0] = f_gate(tdSt == 1, tdSt == -1, tfOkL, tfOkS, strTd, strTd)

// ---- ② MOMENTUM (A3) ----
float lr1  = math.log(close / close[1])
float lrSd = ta.stdev(lr1, moZLen)
float lrN  = math.log(close / close[moLen])
float moZ  = (not na(lrSd) and lrSd > 0) ? lrN / (lrSd * math.sqrt(moLen)) : 0.0
var int moSt = 0
if moZ >= moThr
    moSt := 1
else if moZ <= -moThr
    moSt := -1
else if (moSt == 1 and moZ < 0) or (moSt == -1 and moZ > 0)
    moSt := 0
int strMo = math.abs(moZ) >= moThr * 3 ? 2 : (math.abs(moZ) >= moThr * 2 ? 1 : 0)
[ty1, st1, sg1, pd1, sb1] = f_gate(moSt == 1, moSt == -1, tfOkL, tfOkS, strMo, strMo)

// ---- ③ VOLATİLİTE (A4) ----
float vaTr  = ta.tr(true)
float atrSl = ta.atr(vaSlow)
float atrFs = ta.atr(vaFast)
float vaX   = nz(atrSl[1]) > 0 ? vaTr / atrSl[1] : 1.0
float vaRat = atrSl > 0 ? atrFs / atrSl : 1.0
bool vaUp = vaX >= vaThr and close > open
bool vaDn = vaX >= vaThr and close < open
var int vaSt = 0
if vaUp
    vaSt := 1
else if vaDn
    vaSt := -1
else if vaRat < vaCalm
    vaSt := 0
int strVa = vaX >= vaThr * 1.5 ? 2 : (vaX >= vaThr * 1.2 ? 1 : 0)
[ty2, st2, sg2, pd2, sb2] = f_gate(vaSt == 1, vaSt == -1, tfOkL, tfOkS, strVa, strVa)

// ---- ④ HACİM (A5) ----
float hvSma = ta.sma(volume, hvLen)
float relV  = hvSma > 0 ? volume / hvSma : 1.0
float dltV  = rgO > 0 ? volume * ((close - low) - (high - close)) / rgO : 0.0
float sumD  = math.sum(dltV, hvLen)
float sumV  = math.sum(volume, hvLen)
float flowV = sumV > 0 ? sumD / sumV : 0.0
float sumIn  = 0.0
float sumAll = 0.0
for i = 0 to hvLen - 1
    float vi = nz(volume[i])
    sumAll += vi
    if math.abs(hlc3[i] - close) <= hvBand * atrV
        sumIn += vi
float hvShare = sumAll > 0 ? sumIn / sumAll : 0.0
float hvRat   = relV / math.max(hvShare, 0.1)
bool hvUp = hvRat >= hvThr and flowV >= hvFlow
bool hvDn = hvRat >= hvThr and flowV <= -hvFlow
var int hvSt = 0
if hvUp
    hvSt := 1
else if hvDn
    hvSt := -1
else if (hvSt == 1 and flowV < 0) or (hvSt == -1 and flowV > 0)
    hvSt := 0
int strHv = hvRat >= hvThr * 1.5 ? 2 : (hvRat >= hvThr * 1.2 ? 1 : 0)
[ty3, st3, sg3, pd3, sb3] = f_gate(hvSt == 1, hvSt == -1, tfOkL, tfOkS, strHv, strHv)

plot(volume, "VOL")
plot(ty0, "T_TYPE")
plot(st0, "T_START")
plot(sg0, "T_STR")
plot(pd0, "T_PEND")
plot(sb0, "T_SIG")
plot(ty1, "M_TYPE")
plot(st1, "M_START")
plot(sg1, "M_STR")
plot(pd1, "M_PEND")
plot(sb1, "M_SIG")
plot(ty2, "V_TYPE")
plot(st2, "V_START")
plot(sg2, "V_STR")
plot(pd2, "V_PEND")
plot(sb2, "V_SIG")
plot(ty3, "H_TYPE")
plot(st3, "H_START")
plot(sg3, "H_STR")
plot(pd3, "H_PEND")
plot(sb3, "H_SIG")
