//@version=6
// DEPV2 C6 — GÖLGE KASA + OTOMATİK MOD (kaynak: Devis'So Otomatik Bot Eğitim PaneliV2, f_shadow 1437-1473, f_tPnl/f_tR/f_tUsd 1394-1404, f_selUpdate mod 6).
// A8'in 4 yöntemli onay çıktısı üzerinde 5 hesaplı gölge kasa (4 yöntem + seçili mod) ve iki Otomatik mod yapılandırması çalışır.
// Çıktı: hesap başına işlem sayısı/kazanç/net/sönümlü net/toplam R/yön; seçici başına yön, başlangıç, güç, bekleyen, yöntem, otomatik seçim. Grafik 15 dk.
indicator("DEPV2 C6 · GÖLGE KASA", shorttitle = "C6", precision = 8)

atrPeriod = input.int(10, "ATR Length (atrPeriod)", minval = 1)
tdLen  = input.int(24, "TREND: seviye ortalaması periyodu (HLC3 SMA)", minval = 3)
tdThr  = input.float(0.5, "TREND: min. seviye skoru", minval = 0.05, step = 0.05)
moLen  = input.int(12, "MOMENTUM: ROC periyodu (bar)", minval = 2)
moZLen = input.int(48, "MOMENTUM: σ penceresi", minval = 10)
moThr  = input.float(1.0, "MOMENTUM: min. |z|", minval = 0.1, step = 0.1)
vaSlow = input.int(12, "VOLATİLİTE: yavaş ATR periyodu", minval = 5)
vaFast = input.int(5, "VOLATİLİTE: hızlı ATR periyodu", minval = 2)
vaThr  = input.float(1.3, "VOLATİLİTE: min. genişleme oranı", minval = 1.0, step = 0.05)
vaCalm = input.float(0.8, "VOLATİLİTE: sakinleşme eşiği", minval = 0.1, maxval = 1.0, step = 0.05)
hvLen  = input.int(12, "HACİM: pencere", minval = 5)
hvBand = input.float(0.5, "HACİM: fiyat bölgesi genişliği (± ATR)", minval = 0.1, step = 0.1)
hvThr  = input.float(2.0, "HACİM: min. katılım oranı", minval = 0.5, step = 0.1)
hvFlow = input.float(0.1, "HACİM: min. akış oranı", minval = 0.01, maxval = 1.0, step = 0.01)

ssTf = input.timeframe("15", "Sinyal zaman dilimi (ssTf)")
vpM1 = input.int(2, "MTF 1 çarpanı", minval = 2)
vpM2 = input.int(3, "MTF 2 çarpanı", minval = 2)
vpM3 = input.int(4, "MTF 3 çarpanı", minval = 2)
vpM4 = input.int(6, "MTF 4 çarpanı", minval = 2)
vpCool     = input.int(10, "Sinyal cooldown (sinyal TF barı)", minval = 1, maxval = 100)
vpTfOn     = input.bool(true, "TF onayı sistemini aç")
vpTfNeed   = input.int(3, "Onay için gereken MTF Heikin Ashi sayısı (4 üzerinden)", minval = 1, maxval = 4)
vpConfBars = input.int(1, "Onay için ardışık bar sayısı", minval = 1, maxval = 10)
vpPendMax  = input.int(12, "Onay bekleme süresi (bar)", minval = 1, maxval = 200)

string tfM1 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM1)
string tfM2 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM2)
string tfM3 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM3)
string tfM4 = timeframe.from_seconds(timeframe.in_seconds(ssTf) * vpM4)

f_haScore(string tf) =>
    bool nw = timeframe.change(tf)
    var float cO = na
    var float cH = na
    var float cL = na
    var float pHaO = na
    var float pHaC = na
    if nw or na(cO)
        if not na(cO)
            float lastC = (cO + cH + cL + close[1]) / 4.0
            float lastO = na(pHaO) ? (cO + close[1]) / 2.0 : (pHaO + pHaC) / 2.0
            pHaO := lastO
            pHaC := lastC
        cO := open
        cH := high
        cL := low
    else
        cH := math.max(cH, high)
        cL := math.min(cL, low)
    float haC = (cO + cH + cL + close) / 4.0
    float haO = na(pHaO) ? (cO + close) / 2.0 : (pHaO + pHaC) / 2.0
    float haH = math.max(cH, math.max(haO, haC))
    float haL = math.min(cL, math.min(haO, haC))
    float rg  = haH - haL
    rg != 0 ? (haC - haO) / rg * 100.0 : 0.0

f_gate(bool rawL, bool rawS, bool tfL, bool tfS, int strL, int strS) =>
    var int confDir = 0
    var int lastBar = 0
    var int pendDir = 0
    var int pendBar = 0
    var int pendStr = 0
    var int confCnt = 0
    var float lastSig = -100000.0
    if pendDir == 1 and (not rawL or bar_index - pendBar > vpPendMax)
        pendDir := 0
        confCnt := 0
    if pendDir == -1 and (not rawS or bar_index - pendBar > vpPendMax)
        pendDir := 0
        confCnt := 0
    bool coolOk = (bar_index - lastBar) >= vpCool
    if rawL and confDir != 1 and pendDir != 1 and coolOk
        pendDir := 1
        pendBar := bar_index
        pendStr := strL
        confCnt := 0
        lastBar := bar_index
    if rawS and confDir != -1 and pendDir != -1 and coolOk
        pendDir := -1
        pendBar := bar_index
        pendStr := strS
        confCnt := 0
        lastBar := bar_index
    bool sigL = false
    bool sigS = false
    int  sStr = 0
    if pendDir == 1
        confCnt := tfL ? confCnt + 1 : 0
        if confCnt >= vpConfBars
            sigL := true
            sStr := pendStr + (bar_index > pendBar ? 3 : 0)
            confDir := 1
            pendDir := 0
            confCnt := 0
    else if pendDir == -1
        confCnt := tfS ? confCnt + 1 : 0
        if confCnt >= vpConfBars
            sigS := true
            sStr := pendStr + (bar_index > pendBar ? 3 : 0)
            confDir := -1
            pendDir := 0
            confCnt := 0
    var float lastStart = na
    var float lastType  = 0.0
    var int   lastStr   = 0
    if sigL
        lastStart := low
        lastType  := 1.0
        lastStr   := sStr
        lastSig   := 1.0 * bar_index
    if sigS
        lastStart := high
        lastType  := -1.0
        lastStr   := sStr
        lastSig   := 1.0 * bar_index
    [lastType, lastStart, 1.0 * lastStr, 1.0 * pendDir, lastSig]

// ---- MTF Heikin Ashi gücü + TF onayı (A6 + A7) ----
float hs1 = f_haScore(tfM1)
float hs2 = f_haScore(tfM2)
float hs3 = f_haScore(tfM3)
float hs4 = f_haScore(tfM4)
int nBullTf = (hs1 > 0 ? 1 : 0) + (hs2 > 0 ? 1 : 0) + (hs3 > 0 ? 1 : 0) + (hs4 > 0 ? 1 : 0)
int nBearTf = (hs1 < 0 ? 1 : 0) + (hs2 < 0 ? 1 : 0) + (hs3 < 0 ? 1 : 0) + (hs4 < 0 ? 1 : 0)
bool tfOkL = not vpTfOn or nBullTf >= vpTfNeed
bool tfOkS = not vpTfOn or nBearTf >= vpTfNeed

atrV = ta.atr(atrPeriod)
float rgO = high - low

// ---- ① TREND (A2) ----
float tdMa = ta.sma(hlc3, tdLen)
float tdZ  = atrV > 0 ? (close - tdMa) / atrV : 0.0
var int tdSt = 0
if tdZ >= tdThr
    tdSt := 1
else if tdZ <= -tdThr
    tdSt := -1
else if (tdSt == 1 and tdZ < 0) or (tdSt == -1 and tdZ > 0)
    tdSt := 0
int strTd = math.abs(tdZ) >= tdThr * 3 ? 2 : (math.abs(tdZ) >= tdThr * 2 ? 1 : 0)
[ty0, st0, sg0, pd0, sb0] = f_gate(tdSt == 1, tdSt == -1, tfOkL, tfOkS, strTd, strTd)

// ---- ② MOMENTUM (A3) ----
float lr1  = math.log(close / close[1])
float lrSd = ta.stdev(lr1, moZLen)
float lrN  = math.log(close / close[moLen])
float moZ  = (not na(lrSd) and lrSd > 0) ? lrN / (lrSd * math.sqrt(moLen)) : 0.0
var int moSt = 0
if moZ >= moThr
    moSt := 1
else if moZ <= -moThr
    moSt := -1
else if (moSt == 1 and moZ < 0) or (moSt == -1 and moZ > 0)
    moSt := 0
int strMo = math.abs(moZ) >= moThr * 3 ? 2 : (math.abs(moZ) >= moThr * 2 ? 1 : 0)
[ty1, st1, sg1, pd1, sb1] = f_gate(moSt == 1, moSt == -1, tfOkL, tfOkS, strMo, strMo)

// ---- ③ VOLATİLİTE (A4) ----
float vaTr  = ta.tr(true)
float atrSl = ta.atr(vaSlow)
float atrFs = ta.atr(vaFast)
float vaX   = nz(atrSl[1]) > 0 ? vaTr / atrSl[1] : 1.0
float vaRat = atrSl > 0 ? atrFs / atrSl : 1.0
bool vaUp = vaX >= vaThr and close > open
bool vaDn = vaX >= vaThr and close < open
var int vaSt = 0
if vaUp
    vaSt := 1
else if vaDn
    vaSt := -1
else if vaRat < vaCalm
    vaSt := 0
int strVa = vaX >= vaThr * 1.5 ? 2 : (vaX >= vaThr * 1.2 ? 1 : 0)
[ty2, st2, sg2, pd2, sb2] = f_gate(vaSt == 1, vaSt == -1, tfOkL, tfOkS, strVa, strVa)

// ---- ④ HACİM (A5) ----
float hvSma = ta.sma(volume, hvLen)
float relV  = hvSma > 0 ? volume / hvSma : 1.0
float dltV  = rgO > 0 ? volume * ((close - low) - (high - close)) / rgO : 0.0
float sumD  = math.sum(dltV, hvLen)
float sumV  = math.sum(volume, hvLen)
float flowV = sumV > 0 ? sumD / sumV : 0.0
float sumIn  = 0.0
float sumAll = 0.0
for i = 0 to hvLen - 1
    float vi = nz(volume[i])
    sumAll += vi
    if math.abs(hlc3[i] - close) <= hvBand * atrV
        sumIn += vi
float hvShare = sumAll > 0 ? sumIn / sumAll : 0.0
float hvRat   = relV / math.max(hvShare, 0.1)
bool hvUp = hvRat >= hvThr and flowV >= hvFlow
bool hvDn = hvRat >= hvThr and flowV <= -hvFlow
var int hvSt = 0
if hvUp
    hvSt := 1
else if hvDn
    hvSt := -1
else if (hvSt == 1 and flowV < 0) or (hvSt == -1 and flowV > 0)
    hvSt := 0
int strHv = hvRat >= hvThr * 1.5 ? 2 : (hvRat >= hvThr * 1.2 ? 1 : 0)
[ty3, st3, sg3, pd3, sb3] = f_gate(hvSt == 1, hvSt == -1, tfOkL, tfOkS, strHv, strHv)

rUnit      = input.float(1.5, "R birimi (×ATR)", minval = 0.1, step = 0.1)
startCap   = input.float(1000.0, "Başlangıç kasası (USDT)", minval = 1.0)
riskPct    = input.float(0.5, "1R başına kasa %", minval = 0.05, step = 0.05)
maxLev     = input.float(5.0, "Maks. kaldıraç", minval = 1.0)
feeIn      = input.float(0.02, "Giriş komisyonu (%)", minval = 0.0, step = 0.005)
feeOut     = input.float(0.02, "Çıkış komisyonu (%)", minval = 0.0, step = 0.005)
slipPct    = input.float(0.0, "Slippage (%)", minval = 0.0, step = 0.005)
dynDecay   = input.float(0.97, "Unutma katsayısı", minval = 0.80, maxval = 1.0, step = 0.01)
dynDecayBars = input.int(96, "Sönümleme aralığı (SS barı)", minval = 1)

float feeInE  = feeIn + slipPct
float feeOutE = feeOut + slipPct

var int ssIdx = 0
if timeframe.change(ssTf)
    ssIdx += 1

var array<int>   shDir  = array.new<int>(5, 0)
var array<int>   shPrev = array.new<int>(5, 9)
var array<float> shEnt  = array.new<float>(5, na)
var array<float> shNot  = array.new<float>(5, 0.0)
var array<float> shRu   = array.new<float>(5, na)
var array<int>   shCnt  = array.new<int>(5, 0)
var array<int>   shWin  = array.new<int>(5, 0)
var array<float> shNet  = array.new<float>(5, 0.0)
var array<float> shNetD = array.new<float>(5, 0.0)
var array<float> shSumR = array.new<float>(5, 0.0)

f_tR(int d, float ent, float ru, float px) =>
    ru > 0 ? (d * (px - ent) - (feeInE / 100.0 * ent + feeOutE / 100.0 * px)) / ru : 0.0

f_tUsd(float notl, int d, float ent, float px) =>
    notl * d * (px / ent - 1.0) - notl * feeInE / 100.0 - notl * (px / ent) * feeOutE / 100.0

f_dirM(float v) => na(v) ? 0 : math.round(v)

f_selector(int mode, int autoMinN, float autoMinNet, bool autoBlock) =>
    var int   cbDir = 0
    var int   cbM   = 0
    var float cbSt  = na
    var int   cbStr = 0
    var int   autoM = -1
    dirA = array.from(ty0, ty1, ty2, ty3)
    stA  = array.from(st0, st1, st2, st3)
    sgA  = array.from(sg0, sg1, sg2, sg3)
    pdA  = array.from(pd0, pd1, pd2, pd3)
    int pick = -1
    if barstate.isconfirmed
        int   bm   = -1
        float bs   = autoMinNet
        bool  anyD = false
        for m = 0 to 3
            if shCnt.get(m) >= autoMinN
                anyD := true
                if shNetD.get(m) > bs
                    bs := shNetD.get(m)
                    bm := m
        autoM := bm
        if bm >= 0
            pick := bm
        else if anyD and autoBlock
            cbDir := 0
            cbSt := na
            cbStr := 0
        else
            pick := 0
    if pick >= 0
        int d = f_dirM(dirA.get(pick))
        cbDir := d
        cbM := pick
        if d != 0
            cbSt := stA.get(pick)
            cbStr := math.round(nz(sgA.get(pick), 0.0))
        else
            cbSt := na
            cbStr := 0
    int pd = f_dirM(pdA.get(cbM))
    [1.0 * cbDir, cbSt, 1.0 * cbStr, 1.0 * pd, 1.0 * cbM, 1.0 * autoM]

[s1t, s1s, s1g, s1p, s1m, s1a] = f_selector(6, 3, 0.0, true)
[s2t, s2s, s2g, s2p, s2m, s2a] = f_selector(6, 1, -5.0, false)

f_shadow() =>
    if ssIdx % dynDecayBars == 0
        for i = 0 to 4
            shNetD.set(i, shNetD.get(i) * dynDecay)
    float clS = close
    float atS = atrV
    if not na(clS) and not na(atS) and atS > 0 and clS > 0
        for m = 0 to 4
            int dN = m == 0 ? f_dirM(ty0) : (m == 1 ? f_dirM(ty1) : (m == 2 ? f_dirM(ty2) : (m == 3 ? f_dirM(ty3) : math.round(s1t))))
            int pv = shPrev.get(m)
            if pv == 9
                shPrev.set(m, dN)
            else if dN != pv
                int cd = shDir.get(m)
                if cd != 0
                    float entO = shEnt.get(m)
                    float usdO = f_tUsd(shNot.get(m), cd, entO, clS)
                    float rO   = f_tR(cd, entO, shRu.get(m), clS)
                    shNet.set(m, shNet.get(m) + usdO)
                    shNetD.set(m, shNetD.get(m) + usdO)
                    shSumR.set(m, shSumR.get(m) + rO)
                    shCnt.set(m, shCnt.get(m) + 1)
                    if usdO > 0
                        shWin.set(m, shWin.get(m) + 1)
                    shDir.set(m, 0)
                if dN != 0
                    float ruN   = rUnit * atS
                    float distN = ruN / clS
                    float notN  = math.min(startCap * riskPct / 100.0 / distN, startCap * maxLev)
                    shDir.set(m, dN)
                    shEnt.set(m, clS)
                    shRu.set(m, ruN)
                    shNot.set(m, notN)
                shPrev.set(m, dN)
    0

if barstate.isconfirmed
    f_shadow()

plot(volume, "VOL")
plot(ty0, "T_TYPE")
plot(st0, "T_START")
plot(sg0, "T_STR")
plot(pd0, "T_PEND")
plot(sb0, "T_SIG")
plot(ty1, "M_TYPE")
plot(st1, "M_START")
plot(sg1, "M_STR")
plot(pd1, "M_PEND")
plot(sb1, "M_SIG")
plot(ty2, "V_TYPE")
plot(st2, "V_START")
plot(sg2, "V_STR")
plot(pd2, "V_PEND")
plot(sb2, "V_SIG")
plot(ty3, "H_TYPE")
plot(st3, "H_START")
plot(sg3, "H_STR")
plot(pd3, "H_PEND")
plot(sb3, "H_SIG")
plot(shCnt.get(0), "BK0_CNT")
plot(shWin.get(0), "BK0_WIN")
plot(shNet.get(0), "BK0_NET")
plot(shNetD.get(0), "BK0_NETD")
plot(shSumR.get(0), "BK0_SUMR")
plot(shDir.get(0), "BK0_DIR")
plot(shCnt.get(1), "BK1_CNT")
plot(shWin.get(1), "BK1_WIN")
plot(shNet.get(1), "BK1_NET")
plot(shNetD.get(1), "BK1_NETD")
plot(shSumR.get(1), "BK1_SUMR")
plot(shDir.get(1), "BK1_DIR")
plot(shCnt.get(2), "BK2_CNT")
plot(shWin.get(2), "BK2_WIN")
plot(shNet.get(2), "BK2_NET")
plot(shNetD.get(2), "BK2_NETD")
plot(shSumR.get(2), "BK2_SUMR")
plot(shDir.get(2), "BK2_DIR")
plot(shCnt.get(3), "BK3_CNT")
plot(shWin.get(3), "BK3_WIN")
plot(shNet.get(3), "BK3_NET")
plot(shNetD.get(3), "BK3_NETD")
plot(shSumR.get(3), "BK3_SUMR")
plot(shDir.get(3), "BK3_DIR")
plot(shCnt.get(4), "BK4_CNT")
plot(shWin.get(4), "BK4_WIN")
plot(shNet.get(4), "BK4_NET")
plot(shNetD.get(4), "BK4_NETD")
plot(shSumR.get(4), "BK4_SUMR")
plot(shDir.get(4), "BK4_DIR")
plot(s1t, "S1_TYPE")
plot(s1s, "S1_START")
plot(s1g, "S1_STR")
plot(s1p, "S1_PEND")
plot(s1m, "S1_M")
plot(s1a, "S1_AUTO")
plot(s2t, "S2_TYPE")
plot(s2s, "S2_START")
plot(s2g, "S2_STR")
plot(s2p, "S2_PEND")
plot(s2m, "S2_M")
plot(s2a, "S2_AUTO")
